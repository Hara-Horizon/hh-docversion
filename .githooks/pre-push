#!/usr/bin/env bash
set -euo pipefail

echo "==> Running pre-push workspace checks..."
cargo check --workspace --all-targets
cargo test --workspace
cargo clippy --workspace --all-targets -- -D warnings

echo "==> Verifying binary installation and site packaging..."
cargo doc --no-deps
cargo install --path crates/cargo-docversion --force

# Verify deprecated 'build-site' is completely purged from CLI help
if docversion --help | grep -q "build-site"; then
    echo "Error: deprecated 'build-site' command still present in CLI help!" >&2
    exit 1
fi

# Test standalone binary & consolidated site subcommand
docversion --version
docversion site --out-dir target/prepush_site

# Test Cargo plugin invocation
cargo hh-docversion --version

# Verify expected site outputs exist
test -f target/prepush_site/versions.json
test -f target/prepush_site/index.html
test -d target/prepush_site/latest

echo "==> Pre-push verification passed."
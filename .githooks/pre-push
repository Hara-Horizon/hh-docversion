#!/usr/bin/env bash
set -euo pipefail

# Anchor execution to the repository root
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "==> [01_HAPSAY] Running locked workspace compilation and test suite..."
cargo check --workspace --all-targets --locked
cargo test --workspace --locked
cargo clippy --workspace --all-targets --locked -- -D warnings

echo "==> [02_HAPSAY] Verifying binary installation and site packaging..."
cargo doc --no-deps --locked
cargo install --path crates/cargo-docversion --force --locked

# Verify deprecated 'build-site' is completely purged from CLI help
if docversion --help | grep -q "build-site"; then
    echo "Error: deprecated 'build-site' command still present in CLI help!" >&2
    exit 1
fi

# Verify version and help flags return clean zero exit codes
if ! docversion --version > /dev/null; then
    echo "Error: docversion --version failed or exited non-zero!" >&2
    exit 1
fi

if ! docversion --help > /dev/null; then
    echo "Error: docversion --help failed or exited non-zero!" >&2
    exit 1
fi

# Clean and test standalone binary & consolidated site subcommand
rm -rf target/prepush_site
docversion site --out-dir target/prepush_site

# Test Cargo plugin invocation
cargo hh-docversion --version

# Verify expected site outputs exist
test -f target/prepush_site/versions.json
test -f target/prepush_site/index.html
test -d target/prepush_site/latest

echo "==> [02_HAPSAY] Pre-push verification passed successfully."